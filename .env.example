# ============================================
# Unihub Service Environment Configuration
# Copy this file to .env and fill in values.
# NEVER commit .env to Git.
# ============================================

# PostgreSQL (single instance, multiple databases)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=unihub
POSTGRES_PASSWORD=unihub_local_pass

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=unihub_redis_pass

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_USER=unihub
RABBITMQ_PASSWORD=unihub_rabbit_pass

# MinIO (S3-compatible object storage)
MINIO_ENDPOINT=http://localhost:9000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=unihub_minio
MINIO_ROOT_PASSWORD=unihub_minio_pass

# MailHog (local SMTP testing)
MAIL_HOST=localhost
MAIL_PORT=1025
MAILHOG_UI_PORT=8025

# JWT (RS256 keys - generate locally, never commit real keys)
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# Google Gemini API (for ai-service in Sprint 4)
GEMINI_API_KEY=your_gemini_api_key_here

# Google OAuth2 (optional for local dev)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
